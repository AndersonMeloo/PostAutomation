# .env file for backend configuration

# Banco de Dados Online (ex: Supabase) - preencha com sua connection string
# DATABASE_URL = pooler em modo transaction - usado pela aplicação em runtime
# DIRECT_URL   = conexão direta/session-mode - usado pelo CLI do Prisma (migrate/db pull)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialmedia"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/socialmedia"

JWT_SECRET=1234567890abcdef

# Credenciais do OAuth Client no Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Callback do login com Google
# Online (produção)
# GOOGLE_CALLBACK_URL=https://SEU_DOMINIO_DE_PRODUCAO/auth/google/callback
# Local
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Callback exclusivo do fluxo de CONEXAO do canal do YouTube (separado do login).
# Precisa ser cadastrado como "Authorized redirect URI" no mesmo Client ID do Google Cloud Console.
# Online (produção)
# GOOGLE_YOUTUBE_CALLBACK_URL=https://SEU_DOMINIO_DE_PRODUCAO/auth/youtube/callback
# Local
GOOGLE_YOUTUBE_CALLBACK_URL=http://localhost:3000/auth/youtube/callback

# Online (produção)
# FRONTEND_URL=https://SEU_FRONTEND_DE_PRODUCAO
# Local
FRONTEND_URL=http://localhost:3001
FRONTEND_GOOGLE_REDIRECT_PATH=/auth/google/callback
FRONTEND_YOUTUBE_REDIRECT_PATH=/integrations/youtube/callback

# YouTube configuration
YOUTUBE_DEFAULT_PRIVACY_STATUS=unlisted

# Storage dos rascunhos do editor de vídeo (upload -> corte -> thumbnail -> publicar).
# Se SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY estiverem preenchidos, os uploads vão
# para o Supabase Storage (mesmo projeto do Postgres). Sem essas variáveis, o sistema
# usa disco local (uploads/drafts) automaticamente - útil em dev, mas não sobrevive a
# um redeploy no Railway.
# SUPABASE_URL=https://SEU_PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Nome do bucket no Supabase Storage (crie-o como público antes de usar em produção).
SUPABASE_STORAGE_BUCKET=videos
